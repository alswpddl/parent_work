# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# 빈 값으로 둔 연동은 꺼진 채로 서버가 뜹니다 (화면 [기본 정보 → 상태]에서 무엇이 꺼졌는지 확인).

# dev | prod
APP_ENV=dev

# --- 공개 주소 (카카오 링크·리다이렉트·거래처 주문 링크) ---
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# --- Google Sheets ---
# memory: 구글 연결 없이 예시 데이터로 실행 / gspread: 실제 구글 시트
SHEETS_BACKEND=memory
GOOGLE_SPREADSHEET_ID=
# 토큰·발송기록용 비공개 시트 (비우면 본 시트의 _토큰/_발송기록 탭 사용)
SYSTEM_SPREADSHEET_ID=
# 서비스 계정 키 JSON 전체를 한 줄로 붙여넣거나, 파일 경로를 지정
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEETS_CACHE_TTL=30
AUTO_INIT_SHEETS=true
SEED_DEMO_DATA=true

# --- Claude (카톡 주문 정리). 비우면 규칙 파서로 동작 ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- 카카오 '나에게 보내기' (부모님 브리핑·경고) — docs/카카오_연동_가이드.md ---
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 비우면 {PUBLIC_API_URL}/api/integrations/kakao/callback
KAKAO_REDIRECT_URI=

# --- 솔라피 알림톡 (거래처 안내) — docs/카카오_연동_가이드.md ---
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
SOLAPI_PFID=
SOLAPI_TPL_PARCEL=
SOLAPI_TPL_TRUCK=
SOLAPI_TPL_STATEMENT=
SOLAPI_TPL_ORDER_RECEIVED=
SOLAPI_SMS_FALLBACK=true

# --- 메일 (거래명세표 PDF 첨부) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- PDF 한글 폰트 (비우면 backend/fonts/NotoSansKR-Regular.ttf) ---
PDF_FONT_PATH=

# --- 인증 ---
# 부모님이 입력할 비밀번호(숫자 4자리 이상). dev 에서 비우면 로그인 생략
ADMIN_PIN=
# 32자 이상 임의 문자열 (python -c "import secrets;print(secrets.token_urlsafe(48))")
AUTH_SECRET=
TOKEN_TTL_HOURS=720
# GitHub Actions 가 /api/jobs/* 호출할 때 쓰는 비밀키
JOB_SECRET=

# 프론트 주소 (쉼표로 여러 개)
FRONTEND_ORIGINS=http://localhost:5173

# 비우면 전체 11개 모듈. 일부만 켜려면 쉼표로 나열
ENABLED_MODULES=
ENABLE_INTERNAL_SCHEDULER=false
