{
  "name": "factory-ops",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "pip install -r backend/requirements-dev.txt && cp -n backend/.env.example backend/.env || true",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "API (FastAPI)" },
    "5173": { "label": "화면 (Vite)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "bradlc.vscode-tailwindcss"]
    }
  }
}
